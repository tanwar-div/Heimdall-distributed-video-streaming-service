<?xml version="1.0" encoding="UTF-8"?>
<!--
    Benchmarks import gateway and storage-node classes, which log at INFO on
    every operation. At benchmark call rates that logging is both a large
    share of the measured time and megabytes of noise per run, so it is off.
-->
<configuration>
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} -- %msg%n</pattern>
        </encoder>
    </appender>
    <root level="WARN">
        <appender-ref ref="STDERR"/>
    </root>
</configuration>
