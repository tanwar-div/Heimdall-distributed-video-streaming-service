<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example.heimdall</groupId>
        <artifactId>heimdall-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>heimdall-storage-node</artifactId>
    <packaging>jar</packaging>
    <name>heimdall-storage-node</name>
    <description>
        A single storage node in the Heimdall cluster. The exact same jar is
        deployed as either a "primary" (accepts writes, fans them out to its
        replicas) or a "replica" (read-only, receives replicated data), with
        the role picked purely by configuration. Object bytes are chunked and
        persisted in MinIO / S3-compatible object storage.
    </description>

    <properties>
        <start-class>com.example.heimdall.node.NodeApplication</start-class>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.example.heimdall</groupId>
            <artifactId>heimdall-common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
        </dependency>
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp-jvm</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.jqwik</groupId>
            <artifactId>jqwik</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>heimdall-storage-node</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>${start-class}</mainClass>
                    <!--
                        Attach the executable jar under a classifier so the
                        module's main artifact stays an ordinary library jar.
                        Without this, repackage() replaces the main artifact
                        with a fat jar whose classes live under BOOT-INF/, and
                        heimdall-benchmarks could not compile against this
                        module's services.
                    -->
                    <classifier>boot</classifier>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
